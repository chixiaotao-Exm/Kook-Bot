KOOK_TOKEN=
# Comma-separated KOOK server IDs. Required to prevent unintended use.
ALLOWED_GUILD_IDS=
# Optional: only accept commands in these text channels.
ALLOWED_TEXT_CHANNEL_IDS=
# Optional: these users may control playback without joining the voice channel.
ADMIN_USER_IDS=
COMMAND_PREFIX=/
DATA_DIR=./data
FFMPEG_PATH=ffmpeg
DEFAULT_VOLUME=5
MAX_QUEUE_SIZE=500
IDLE_TIMEOUT_SECONDS=300
COMMAND_COOLDOWN_SECONDS=2
NETEASE_COOKIE=
# Python environment containing qqmusic-api-python 0.7.2.
QQ_PYTHON_PATH=python3
QISHUI_API_URL=
QISHUI_API_TOKEN=
STAY_CONNECTED=true
WEB_ENABLED=false
WEB_HOST=127.0.0.1
WEB_PORT=8787
WEB_SECURE_COOKIE=false
WEB_REQUIRE_PASSWORD=false
