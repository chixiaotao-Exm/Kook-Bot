[Unit]
Description=KOOK NetEase Music Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=kookbot
Group=kookbot
WorkingDirectory=/opt/kook-music-bot
ExecStart=/usr/bin/node --env-file=/opt/kook-music-bot/.env /opt/kook-music-bot/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillMode=mixed
UMask=0077
Environment=NODE_ENV=production
Environment=DOTENV_CONFIG_QUIET=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kook-music-bot/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
