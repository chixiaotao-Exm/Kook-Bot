[Unit]
Description=Private PUBG report browser adapter on port %i
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# Create the restricted loopback-only container before enabling this instance.
# Instances 8192 through 8200 use containers with the corresponding port suffix.
ExecStart=/usr/bin/docker start --attach kook-report-browser-%i
ExecStop=/usr/bin/docker stop --time 10 kook-report-browser-%i
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
