[Unit]
Description=Private PUBG report browser adapter
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# Create the restricted loopback-only container before enabling this unit.
ExecStart=/usr/bin/docker start --attach kook-report-browser
ExecStop=/usr/bin/docker stop --time 10 kook-report-browser
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
