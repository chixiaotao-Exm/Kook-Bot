KOOK_TOKEN=
KOOK_CHANNEL_ID=
# Each live report still requires its initiator to confirm the preview.
PUBG_SUBMIT_ENABLED=false
# One UTF-8 line per reporter: SteamID64<TAB>PUBG nickname. A header is optional.
# Reloaded for every preview and confirmation. Relative to the working directory.
REPORTERS_FILE=./data/reporters.txt
# Fixed for every TXT account. Empty values fall back to the imported profile.json.
PUBG_REPORTER_EMAIL=
PUBG_REPORTER_LANGUAGE=english
# Optional private single-submit browser adapter; never point this to raw FlareSolverr.
# REPORT_BROWSER_URL=http://127.0.0.1:8191
# Comma-separated independent adapters; takes precedence over REPORT_BROWSER_URL.
# REPORT_BROWSER_URLS=http://127.0.0.1:8191,http://127.0.0.1:8192,http://127.0.0.1:8193
# Default 1. Integer 1..4; cannot exceed the number of independent browser URLs.
REPORT_CONCURRENCY=1
# REPORT_BROWSER_TOKEN=GENERATE_64_HEX_CHARACTERS
PADDLEOCR_ENDPOINT=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_TOKEN=
PADDLEOCR_MODEL=PP-OCRv6
DATA_DIR=./data
HOST=127.0.0.1
PORT=18992
# Gmail receipt check: same mailbox as the reporter profile, app password only.
GMAIL_RECEIPTS_ENABLED=false
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
