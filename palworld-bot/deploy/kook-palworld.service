[Unit]
Description=KOOK Palworld game events and AI item assistance
After=network-online.target palworld-panel.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/kook-palworld/palworld-bot
EnvironmentFile=/opt/kook-palworld/.env
ExecStart=/usr/bin/node /opt/kook-palworld/palworld-bot/gateway.mjs
Restart=always
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/kook-palworld/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=384M
TasksMax=48

[Install]
WantedBy=multi-user.target
