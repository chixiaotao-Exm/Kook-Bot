# Dedicated private environment for the independent dual-bot service.
KOOK_BOT_A_TOKEN=
KOOK_BOT_B_TOKEN=
KOOK_CHANNEL_ID=
OPENAI_API_KEY=

# HTTPS API root or /v1; local HTTP is allowed only on loopback.
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_MODEL=gpt-6-astra
# Optional independent models; empty values use OPENAI_MODEL.
DUET_MODEL_A=
DUET_MODEL_B=
BOT_A_LABEL=机器人A
BOT_B_LABEL=机器人B

# Zero means continuous discussion until manually stopped, with no total deadline.
# An optional finite round means one message from A and one message from B.
DUET_ROUNDS=0
DUET_DEADLINE_SECONDS=0
DUET_BETWEEN_TURNS_MS=2000
MODEL_TIMEOUT_SECONDS=180
DUET_MAX_OUTPUT_TOKENS=1200
REASONING_EFFORT=low

HOST=127.0.0.1
PORT=19000
DATA_DIR=./data

# Repository tools are disabled unless an authorized KOOK user is configured.
CODE_AGENT_ENABLED=false
CODE_AGENT_OPERATOR_IDS=
CODE_AGENT_SOCKET=/run/kook-code-agent/broker.sock
