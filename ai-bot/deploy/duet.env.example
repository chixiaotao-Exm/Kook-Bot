# Dedicated private environment for the independent dual-bot service.
KOOK_BOT_A_TOKEN=
KOOK_BOT_B_TOKEN=
KOOK_CHANNEL_ID=
OPENAI_API_KEY=

# HTTPS API root or /v1; local HTTP is allowed only on loopback.
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_MODEL=gpt-6-astra
# Optional independent models; empty values use OPENAI_MODEL.
DUET_MODEL_A=
DUET_MODEL_B=
BOT_A_LABEL=机器人A
BOT_B_LABEL=机器人B

# One round means one message from A and one message from B.
DUET_ROUNDS=6
DUET_DEADLINE_SECONDS=600
DUET_BETWEEN_TURNS_MS=2000
MODEL_TIMEOUT_SECONDS=180
DUET_MAX_OUTPUT_TOKENS=1200
REASONING_EFFORT=low

HOST=127.0.0.1
PORT=19000
DATA_DIR=./data
