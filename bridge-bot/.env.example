HOST=127.0.0.1
PORT=18997
DATA_DIR=./data
GITHUB_REPOSITORY=chixiaotao-Exm/Kook-Bot
# Optional comma-separated allowlist, takes precedence over GITHUB_REPOSITORY.
# GITHUB_REPOSITORIES=example/first,example/second
# Optional per-repository KOOK bot tokens; keep this JSON private. The channel remains the same.
# GITHUB_REPOSITORY_TOKENS={"example/second":"another-private-kook-token"}
# Generate a new random secret, then use the same secret in the GitHub webhook.
GITHUB_WEBHOOK_SECRET=
KOOK_TOKEN=
KOOK_CHANNEL_ID=
